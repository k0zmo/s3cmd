object BucketCreation: TDialogBox
  Caption = 'Create bucket'
  ClientHeight = 294
  ClientWidth = 620
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Position = poScreenCenter
  OnShow = DialogBoxShow
  object PrefixLabel: TLabel
    Left = 16
    Top = 22
    Caption = 'Name / prefix:'
  end
  object BucketPrefix: TEdit
    Left = 128
    Top = 16
    Width = 476
    Height = 30
    TabOrder = 0
    OnChange = EditChange
  end
  object NamespaceLabel: TLabel
    Left = 16
    Top = 62
    Caption = 'Namespace:'
  end
  object BucketNamespace: TComboBox
    Left = 128
    Top = 56
    Width = 476
    Height = 30
    Style = csDropDownList
    Items.Strings = (
      'Global'
      'Account regional'
    )
    TabOrder = 1
    OnChange = ComboBoxChange
  end
  object RegionLabel: TLabel
    Left = 16
    Top = 102
    Caption = 'Region:'
  end
  object BucketRegion: TComboBox
    Left = 128
    Top = 96
    Width = 476
    Height = 30
    MaxLength = 63
    TabOrder = 2
    OnChange = ComboBoxChange
    OnExit = ComboBoxExit
  end
  object PreviewLabel: TLabel
    Left = 16
    Top = 142
    Caption = 'Bucket name:'
  end
  object BucketPreview: TEdit
    Left = 128
    Top = 136
    Width = 476
    Height = 30
    ReadOnly = True
    TabOrder = 3
  end
  object BucketError: TLabel
    Left = 16
    Top = 180
    Width = 588
    Height = 56
    AutoSize = False
    WordWrap = True
  end
  object CreateButton: TButton
    Left = 428
    Top = 248
    Width = 80
    Height = 30
    Caption = 'Create'
    Default = True
    Enabled = False
    TabOrder = 4
    OnClick = ButtonClick
  end
  object CancelButton: TButton
    Left = 524
    Top = 248
    Width = 80
    Height = 30
    Caption = 'Cancel'
    Cancel = True
    ModalResult = 2
    TabOrder = 5
    OnClick = ButtonClick
  end
end
