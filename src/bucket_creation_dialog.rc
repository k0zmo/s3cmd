#include <windows.h>
#include "resource.h"

IDD_BUCKET_CREATION DIALOGEX 0, 0, 310, 124
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create bucket"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Name / prefix:", -1, 7, 10, 60, 10
    EDITTEXT IDC_BUCKET_PREFIX, 70, 7, 233, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Namespace:", -1, 7, 28, 60, 10
    COMBOBOX IDC_BUCKET_NAMESPACE, 70, 25, 233, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Region:", -1, 7, 46, 60, 10
    COMBOBOX IDC_BUCKET_REGION, 70, 43, 233, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Bucket name:", -1, 7, 64, 60, 10
    EDITTEXT IDC_BUCKET_PREVIEW, 70, 61, 233, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "", IDC_BUCKET_ERROR, 7, 79, 296, 20
    DEFPUSHBUTTON "Create", IDOK, 187, 103, 56, 14
    PUSHBUTTON "Cancel", IDCANCEL, 247, 103, 56, 14
END
