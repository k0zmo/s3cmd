#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_PROPERTIES DIALOGEX 0, 0, 410, 318
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "S3 Properties"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "S3 address:", -1, 7, 10, 46, 10
    EDITTEXT IDC_PROPERTIES_ADDRESS, 57, 7, 290, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "&Copy", IDC_PROPERTIES_COPY_ADDRESS, 351, 7, 52, 14
    LTEXT "Region:", -1, 7, 30, 46, 10
    EDITTEXT IDC_PROPERTIES_REGION, 57, 27, 346, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    EDITTEXT IDC_PROPERTIES_DETAILS, 7, 47, 396, 55, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Tags", IDC_PROPERTIES_TAG_GROUP, 7, 105, 396, 85
    CONTROL "", IDC_PROPERTIES_TAGS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 14, 118, 382, 50
    LTEXT "", IDC_PROPERTIES_TAG_STATUS, 14, 171, 382, 16
    GROUPBOX "Share object", IDC_PROPERTIES_LINK_GROUP, 7, 196, 396, 94
    LTEXT "Expires after:", IDC_PROPERTIES_EXPIRY_LABEL, 14, 212, 48, 10
    COMBOBOX IDC_PROPERTIES_EXPIRY, 65, 209, 92, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Generate link", IDC_PROPERTIES_GENERATE, 164, 209, 78, 14
    EDITTEXT IDC_PROPERTIES_URL, 14, 228, 326, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "Copy &link", IDC_PROPERTIES_COPY_URL, 344, 228, 52, 14
    LTEXT "", IDC_PROPERTIES_LINK_STATUS, 14, 246, 382, 18
    LTEXT "Anyone with this link can download the object.\nTemporary credentials can expire before the selected duration.", IDC_PROPERTIES_WARNING, 14, 267, 382, 20
    DEFPUSHBUTTON "Close", IDCANCEL, 347, 297, 56, 14
END
